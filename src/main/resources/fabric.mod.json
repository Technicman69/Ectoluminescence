{
	"schemaVersion": 1,
	"id": "ectolum",
	"version": "${version}",
	"name": "Ectoluminescence",
	"description": "Ectolum - Adds more use cases for \"USELESS\" minecraft features such as Glow Ink Sac, Phantom Membrane or Echo Shard. The mod implements ideas proposed by Nekoma in their youtube video",
	"authors": [
		"Technicman"
	],
	"contact": {
		"sources": "https://github.com/Technicman69/Ectoluminescence"
	},
	"license": "CC0-1.0",
	"icon": "icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.technicman.ectolum.Ectoluminescence"
		],
		"client": [
			"com.technicman.ectolum.EctoluminescenceClient"
		],
		"jei_mod_plugin": [
			"com.technicman.ectolum.integration.jei.Plugin"
		]
	},
	"mixins": [
		"ectolum.mixins.json",
		{
			"config": "ectolum.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"glow_ink_plus": "*",
		"jei": ">=19.50.0.414"
	}
}